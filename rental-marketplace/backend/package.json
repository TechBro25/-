{
  "name": "rental-marketplace-backend",
  "version": "1.0.0",
  "description": "Backend for rental marketplace with inbox and WhatsApp verification",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node -e \"require('./src/db.js').runMigrations()\"",
    "seed": "node -e \"require('./src/db.js').runSeeds()\"",
    "test": "node tests/booking.test.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "express-rate-limit": "^7.1.5",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "node-fetch": "^2.7.0"
  },
  "keywords": ["rental", "marketplace", "whatsapp", "verification"],
  "author": "Rental Marketplace",
  "license": "MIT"
}